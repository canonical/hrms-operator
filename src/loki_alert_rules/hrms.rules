groups:
  - name: frappe_hrms_logs
    rules:
      - alert: HRMSHighErrorLogRate
        expr: |
          sum(rate({%%juju_topology%%} |= "ERROR" [5m])) > 5
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High error log rate for HRMS"
          description: >-
            HRMS is emitting more than 5 ERROR log lines per second averaged over
            the last 5 minutes.
