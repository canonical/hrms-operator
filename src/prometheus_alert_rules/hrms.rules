groups:
  - name: frappe_hrms
    rules:
      - alert: HRMSHighServerErrorRatio
        expr: |
          sum(rate(gunicorn_request_status_total{status=~"5.."}[5m]))
            /
          sum(rate(gunicorn_request_status_total[5m]))
            > 0.05
          and
          sum(rate(gunicorn_request_status_total[5m])) > 1
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Elevated HRMS 5xx error ratio"
          description: >-
            More than 5% of HRMS HTTP responses were 5xx over the last 5 minutes
            (sustained for 15 minutes) while serving more than 1 request per
            second. Service-down conditions are covered separately by the
            built-in HostDown/HostMetricsMissing alerts.
