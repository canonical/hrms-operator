groups:
  - name: frappe_hrms
    rules:
      - alert: HRMSMetricsExporterDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "HRMS metrics exporter is down"
          description: >-
            The Prometheus scrape target for {{ $labels.juju_application }}/{{ $labels.juju_unit }}
            has been unreachable for more than 5 minutes.
      - alert: HRMSHighServerErrorRate
        expr: sum(rate(gunicorn_request_status_total{status=~"5.."}[5m])) > 1
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Elevated 5xx response rate in HRMS"
          description: >-
            HRMS is returning more than one HTTP 5xx response per second averaged
            over the last 5 minutes.
